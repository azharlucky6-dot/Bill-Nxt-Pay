      </section>

      <!-- SUPPORT VIEW -->
      <section id="viewSupport" class="hidden space-y-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
          <h2 class="text-base font-bold text-slate-900">Help, Security &amp; Grievance</h2>
          <p class="text-xs text-slate-600">Failed BBPS or UPI payments are auto-reversed within T+1 to T+5 working days.</p>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1">
            <div class="font-semibold text-slate-800">Grievance Officer (RBI / IT Rules)</div>
            <div class="text-slate-600">Email: grievance@nxtpay-demo.in</div>
            <div class="text-slate-600">SLA: 24h acknowledgement &bull; 30-day resolution</div>
          </div>
          <button id="btnOpenTermsFromSupport" type="button" class="w-full py-2.5 rounded-xl bg-indigo-900 text-white text-xs font-semibold">Read Terms &amp; Security Policy</button>
        </div>
      </section>
    </main>

    <!-- Bottom Floating Navigation Bar -->
    <nav class="fixed bottom-3 left-1/2 -translate-x-1/2 w-[calc(100%-24px)] max-w-[406px] bg-white/95 backdrop-blur-md border border-slate-200 rounded-full px-3 py-1.5 shadow-xl flex items-center justify-between z-30">
      <button type="button" data-tab="loan" class="nav-tab flex flex-col items-center gap-0.5 px-2.5 py-1 text-slate-500 hover:text-indigo-900">
