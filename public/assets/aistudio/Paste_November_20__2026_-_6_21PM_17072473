            <div class="mt-2 inline-flex items-center text-[11px] font-semibold text-rose-800">
              Explore <i data-lucide="arrow-right" class="w-3 h-3 ml-1"></i>
            </div>
          </button>
        </div>

        <!-- Upcoming Payments Preview -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold text-slate-900">Upcoming Payments</h2>
            <button id="btnViewAllHistory" type="button" class="text-xs font-semibold text-indigo-700 hover:underline">View all</button>
          </div>
          <div id="upcomingList" class="space-y-2.5"></div>
        </div>
      </section>

      <!-- LOAN VIEW -->
      <section id="viewLoan" class="hidden space-y-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
          <h2 class="text-base font-bold text-slate-900">Instant Credit &amp; Business Loans</h2>
          <p class="text-xs text-slate-600">Pre-approved partner offers via RBI-registered NBFCs. Zero impact on credit score for eligibility check.</p>
          <div class="space-y-2.5 pt-1">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between">
              <div>
                <div class="text-sm font-semibold text-slate-900">Personal Flexi Loan</div>
                <div class="text-xs text-slate-500">Up to ₹5,00,000 &bull; 11.9% p.a.</div>
              </div>
              <button type="button" data-loan="Personal Flexi Loan" class="btn-loan-apply px-3 py-1.5 rounded-lg bg-indigo-900 text-white text-xs font-semibold">Check</button>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between">
              <div>
                <div class="text-sm font-semibold text-slate-900">Merchant Working Capital</div>
                <div class="text-xs text-slate-500">Up to ₹15,00,000 &bull; Daily/Weekly EMI</div>
              </div>
              <button type="button" data-loan="Merchant Working Capital" class="btn-loan-apply px-3 py-1.5 rounded-lg bg-indigo-900 text-white text-xs font-semibold">Check</button>
            </div>
          </div>
        </div>
      </section>

      <!-- CARDS VIEW -->
      <section id="viewCards" class="hidden space-y-4">
        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900">Linked Credit Cards</h2>
            <button id="btnAddNewCardModal" type="button" class="text-xs font-semibold text-indigo-700 hover:underline">+ Link Card</button>
          </div>
          <div id="cardsManageList" class="space-y-3"></div>
        </div>
      </section>

      <!-- HISTORY VIEW -->
      <section id="viewHistory" class="hidden space-y-4">
        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
          <h2 class="text-base font-bold text-slate-900 mb-3">Transaction Ledger (BBPS)</h2>
          <div id="historyList" class="space-y-2.5"></div>
