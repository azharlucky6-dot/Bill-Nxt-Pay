          </div>
        </div>

        <!-- Activate Wallet CTA -->
        <button id="btnActivateWallet" type="button" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-center gap-2 hover:from-emerald-100 hover:to-teal-100 transition">
          <i data-lucide="shield" class="w-4 h-4 text-emerald-700"></i>
          <span id="walletCtaText">Activate your Wallet NXT &rarr;</span>
        </button>

        <!-- Growth Cards Row -->
        <div class="grid grid-cols-2 gap-3">
          <button id="btnReferEarn" type="button" class="text-left rounded-2xl p-3.5 bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/70 hover:border-amber-300 transition">
            <div class="text-sm font-bold text-slate-900">Refer &amp; Earn</div>
            <div class="text-xs text-slate-600 mt-0.5">Earn 500 NXT Cash</div>
            <div class="mt-2 inline-flex items-center text-[11px] font-semibold text-amber-800">
