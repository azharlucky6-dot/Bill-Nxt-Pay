          <button id="btnApplyCard" type="button" class="text-left rounded-2xl p-3.5 bg-gradient-to-br from-rose-50 to-orange-50 border border-rose-200/70 hover:border-rose-300 transition">
            <div class="text-sm font-bold text-slate-900">Apply New Card</div>
